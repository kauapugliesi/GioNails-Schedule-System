# ===== Banco de dados (usado pelo docker-compose) =====
POSTGRES_DB=gionails_schedule
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque-esta-senha

# ===== Backend (Spring Boot lê estas variáveis) =====
DB_URL=jdbc:postgresql://localhost:5432/gionails_schedule
DB_USER=agenda
DB_PASSWORD=troque-esta-senha
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Será usado na etapa 2 (autenticação). Gere com: openssl rand -base64 48
JWT_SECRET=

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8080

# ===== Autenticação (etapa 2) =====
JWT_EXPIRATION_MINUTES=480
# Conta da manicure: criada automaticamente na 1ª inicialização (senha de 8 a 72 caracteres)
MANICURE_NOME=Giovanna Pugliesi
MANICURE_TELEFONE=
MANICURE_SENHA=
